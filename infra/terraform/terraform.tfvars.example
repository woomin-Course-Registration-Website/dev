aws_region             = "ap-northeast-2"
environment            = "prod"
project                = "student-mgmt"

eks_node_instance_type = "t3.medium"
eks_node_desired       = 2
eks_node_min           = 2 # 무중단 배포를 위해 최소 2 유지
eks_node_max           = 5

db_username = "appuser"
db_password = "CHANGE_ME_strong_password_no_special_chars"               # RDS 호환: 영숫자 권장 (예: openssl rand -hex 24)
jwt_secret  = "CHANGE_ME_at_least_256_bits_long_secret_key_here_padding" # 예: openssl rand -base64 48

github_org  = "your-github-username-or-org"
github_repo = "dev"

# Amplify가 GitHub repo를 watch하기 위한 PAT (classic: repo + admin:repo_hook 권한)
# GitHub → Settings → Developer settings → Personal access tokens → Tokens(classic)
amplify_github_token = "ghp_CHANGE_ME"

# (선택) EKS 퍼블릭 API 엔드포인트 접근 허용 CIDR — 운영 시 사무실/VPN IP로 좁히기 권장
# cluster_endpoint_public_access_cidrs = ["1.2.3.4/32"]
